#!/bin/bash
set -e

# Add /sbin to path if necessary
if [[ -f /sbin/sysctl && -x /sbin/sysctl ]]; then sysctl_bin=/sbin/sysctl
else sysctl_bin=sysctl
fi

export ROOT=$(pwd)/build
mkdir -p "$ROOT"
echo "ROOT is set to: $ROOT"

export NCORES=$(nproc)

VERSION_NUMBER=""
GTK_VERSION=""
BUILD_APP=""
BUILD_IMAGE=""

while getopts ":iagvhg:" opt; do
  case ${opt} in
    i )
        BUILD_IMAGE="1"
        ;;
    a )
        BUILD_APP="1"
        ;;
    g )
        GTK_VERSION=$OPTARG
        ;;
    v )
        VERSION_NUMBER="-@SLIC3R_VERSION_FULL@"
        ;;
    h )
        echo "Usage: ./BuildLinuxImage.sh [-g GTK_VERSION][-i][-a][-v][-h]"
        echo "   -g: force gtk2 or gtk3 build"
        echo "   -i: generate .tgz and Appimage (optional)"
        echo "   -a: generate app only (optional)"
        echo "   -v: add version number (optional)"
        echo "   -h: help"
        exit 0
        ;;
    \? )
        echo "Invalid Option: -$OPTARG" 1>&2
        exit 1
        ;;
  esac
done

if [[ -n "$BUILD_APP" ]]; then
    echo -e "\n[7/8] Generating Linux app ..."

    if [[ -d "package" ]]; then
        rm -rf package/*
        find package -mindepth 1 -delete
    else
        mkdir package
    fi
    mkdir -p package/bin

    cp -rf ../resources/ package/resources
    cp -f bin/@SLIC3R_APP_CMD@ package/bin/@SLIC3R_APP_CMD@
    cp -f src/OCCTWrapper.so package/bin

    ln -rs package/bin/@SLIC3R_APP_CMD@ package/bin/@GCODEVIEWER_APP_CMD@

    find package/resources/localization \( -name "*.po" -o -name "*.pot" -o -name "*.ini" -o -name "*.py" -o -name "*.md" -o -name "*.txt" -o -name "*database*" -o -name "Slic3r.mo" \) -type f -delete

    echo -e '#!/bin/bash\nDIR=$(readlink -f "$0" | xargs dirname)\nexport LD_LIBRARY_PATH="$DIR/bin"\nexec "$DIR/bin/@SLIC3R_APP_CMD@" "$@"' > package/@SLIC3R_APP_CMD@
    chmod +x package/@SLIC3R_APP_CMD@

    echo -e '#!/bin/bash\nDIR=$(readlink -f "$0" | xargs dirname)\nexport LD_LIBRARY_PATH="$DIR/bin"\nexec "$DIR/bin/@GCODEVIEWER_APP_CMD@" "$@"' > package/@GCODEVIEWER_APP_CMD@
    chmod +x package/@GCODEVIEWER_APP_CMD@

    echo -e "\n... app package prepared\n"
fi

if [[ -n "$BUILD_IMAGE" ]]; then
    echo -e "\n[8/8] Creating .tgz and AppImage for distribution ..."

    pushd package > /dev/null
    if [[ "$GTK_VERSION" == 2 ]]; then
        tar -czvf ../@SLIC3R_APP_KEY@${VERSION_NUMBER}-linux-x64-GTK2.tgz . > /dev/null
    elif [[ "$GTK_VERSION" == 3 ]]; then
        tar -czvf ../@SLIC3R_APP_KEY@${VERSION_NUMBER}-linux-x64-GTK3.tgz . > /dev/null
    else
        echo -e "\nError: Only GTK2 and GTK3 versions are supported. Asked GTK version: '$GTK_VERSION'"
        exit 1
    fi
    popd > /dev/null
fi

# Build AppImage
chmod +x ../src/build_appimage.sh
../src/build_appimage.sh

# Show content
if [[ -d "$ROOT/bin" ]]; then
    echo "> ls -al $ROOT/bin"
    ls -al "$ROOT/bin"
else
    echo "Warning: $ROOT/bin does not exist"
fi

if [[ -d "$ROOT/src" ]]; then
    echo "> ls -al $ROOT/src"
    ls -al "$ROOT/src"
else
    echo "Warning: $ROOT/src does not exist"
fi

# Rename AppImage after build
if [[ "$GTK_VERSION" == 2 ]]; then
    mv package/"@SLIC3R_APP_KEY@_ubu64.AppImage" "@SLIC3R_APP_KEY@${VERSION_NUMBER}-linux-x64-GTK2.AppImage"
elif [[ "$GTK_VERSION" == 3 ]]; then
    mv package/"@SLIC3R_APP_KEY@_ubu64.AppImage" "@SLIC3R_APP_KEY@${VERSION_NUMBER}-linux-x64-GTK3.AppImage"
else
    echo -e "\nError: Only GTK2 and GTK3 versions supported. Asked GTK version: '$GTK_VERSION'"
    exit 1
fi

echo -e "\n... done\n"
